      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exported_instance) (rate(worker_network_rx_kb{exported_instance=~\"$worker\"}[$__rate_interval])) * 1024",
